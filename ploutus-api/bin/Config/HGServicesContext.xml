  </object>

  <object id="HGLogService" type="HG.Api.src.implementations.HGLogService, HG.Api" parent="HGAbstractService">


    <property name="WalletService" ref="WalletService"/>
    <property name="UserTokenService" ref="UserTokenService"/>
    <property name="PlayerProfileService" ref="PlayerProfileService"/>
    <property name="PlayerRegistrationService" ref="PlayerRegistrationService"/>
    <property name="HGFundTransferHistoryService" ref="HGFundTransferHistoryService"/>
    <property name="WalletManager" ref="WalletManager"/>
    <property name="HGFundTransferHistoryService" ref="HGFundTransferHistoryService"/>
