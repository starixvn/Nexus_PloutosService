@model dynamic
@using blueberry.core.src.Models
@using blueberry.core.src.Enums

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<p></p>
<div class="container">
    <ul class="nav nav-tabs">
        <li><a data-toggle="tab" href="#Profile">Profile</a></li>
        <li><a data-toggle="tab" href="#Transaction">Transaction</a></li>
        <li><a data-toggle="tab" href="#Wins">Wins</a></li>
        <li><a data-toggle="tab" href="#Loss">Loss</a></li>
    </ul>
    <div class="tab-content">
        <div id="Profile" class="tab-pane fade in active">
            <p></p>

            <div>
                <dl class="dl-horizontal">
                    <dt>
                        Player Code
                    </dt>
                    <dd>
                        @Model.Player.PlayerCode
                    </dd>
                    <dt>
                        User Name
                    </dt>
                    <dd>
                        @Model.Player.UserName
                    </dd>
                    <dt>
                        Wallet Code
                    </dt>
                    <dd>
                        @Model.Player.WalletCode
                    </dd>
                    <dt>
                        Wallet Balance
                    </dt>
                    <dd>
                        @Model.Player.WalletBalance.ToString("N2")
                    </dd>

                </dl>
            </div>
            <p>
                @Html.ActionLink("Edit", "Edit", new { id = Model.Player.Id }, new { @class = "btn btn-info" }) |
                @Html.ActionLink("Reset Password", "ResetPassword", new { id = Model.Player.Id }, new { @class = "btn btn-success" })
                @Html.ActionLink("Back to List", "List", null, new { @class = "btn btn-default" })
            </p>


        </div>

        <div id="Transaction" class="tab-pane fade">
            <p></p>

            <div>
                <div class="form-horizontal">
                    <form method="post" action="/SubAgentPlayer/TransferBalance">

                        @Html.Hidden("SourceWalletId", (string)Model.SourceWallet.Id.ToString())
                        @Html.Hidden("DestinationWalletId", (string)Model.DestinationWallet.Id.ToString())
                        @Html.Hidden("PlayerId", (string)Model.Player.Id.ToString())
                        <dl class="dl-horizontal">
                            <dt>
                                User Name
                            </dt>

                            <dd>
                                @Model.Player.UserName
                            </dd>
                            <dt>
                                Wallet Balance
                            </dt>

                            <dd>
                                @Model.DestinationWallet.Balance.ToString("N2")
                            </dd>

                            <dt>
                                Transfer Type
                            </dt>
                            <dd>
                                Fund In <input checked="checked"
                                               id="FundIn"
                                               name="FundIn"
                                               type="radio"
                                               value="True" />
                                Fund Out <input id="FundOut"
                                                name="FundIn"
                                                type="radio"
                                                value="False" />
                            </dd>




                            <dt>
                                Amount
                            </dt>

                            <dd style="text-align: left;">
                                @Html.TextBox("TransferAmount", "0.00", new { @class = "form-control bfh-number" })
                            </dd>
                        </dl>


                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="submit" value="Transfer" class="btn btn-success" />
                                @Html.ActionLink("Back to List", "ListByParent", null, new { @class = "btn btn-default" })
                            </div>
                        </div>
                    </form>


                    <div>
                        <p><b>History</b></p>
                        <table id="depositRecords" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>
                                        Transaction No.
                                    </th>
                                    <th>
                                        Transaction Date
                                    </th>
                                    <th>
                                        Type
                                    </th>
                                    <th>
                                        Amount
                                    </th>
                                    <th>
                                        Agent
                                    </th>


                                </tr>
                            </thead>
                            <tbody>
                                @foreach (WalletFundTransfer item in Model.FundTransfers)
                                {
                                    <tr>
                                        <td>
                                            @item.TransactionNo
                                        </td>
                                        <td>
                                            @item.TransactionDate
                                        </td>
                                        <td>
                                            @if (item.FundTransferType == FundTransferType.TransferIn)
                                            {
                                                @:Transfer In
                                            }
                                            else
                                            {
                                                @:Transfer Out
                                            }
                                        </td>
                                        <td>
                                            @item.TransferAmount
                                        </td>
                                        <td>
                                            @if (item.MasterAgent == null)
                                            {

                                                @Html.DisplayFor(modelItem => item.SubAgent.UserName)
                                            }
                                            else
                                            {
                                                @Html.DisplayFor(modelItem => item.MasterAgent.UserName)
                                            }
                                        </td>

                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>


                </div>

            </div>

        </div>

        <div id="Wins" class="tab-pane fade">

            <p><b>Player Wins</b></p>
            <table id="walletWinRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>                        
                        <th>
                            Transaction No
                        </th>

                        <th>
                            Transaction Date
                        </th>

                        <th>
                            Bet Amount
                        </th>

                        <th>
                            Win Amount
                        </th>
                        <th>
                            Game Platform Code
                        </th>                       
                    </tr>
                </thead>
                <tbody>
                    @foreach (WalletWin item in Model.WalletWins)
            {
                        <tr>
                           
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BetAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.WinAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.GamePlatform.GamePlatformCode)
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <div id="Loss" class="tab-pane fade">
            <p><b>Player Loss</b></p>
            <table id="walletLossRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>                        
                        <th>
                            Transaction No
                        </th>

                        <th>
                            Transaction Date
                        </th>

                        <th>
                            Bet Amount
                        </th>

                        <th>
                            Win Amount
                        </th>
                        <th>
                            Game Platform Code
                        </th>                       
                    </tr>
                </thead>
                <tbody>
                    @foreach (WalletLoss item in Model.WalletLosses)
            {
                        <tr>                           
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BetAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.LossAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.GamePlatform.GamePlatformCode)
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>


    </div>



</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script type="text/javascript">
    var errorMessage = "@TempData["ErrorMessage"]";
    $(document).ready(function () {
        
        @if (TempData["ErrorMessage"] !=null)
        {
            @:errorMesage = "@TempData["ErrorMessage"]"
        }
        if (errorMessage.length > 0) {
            ShowNotification("Error", errorMessage, "error");
            //alert(errorMessage);
        }

        console.log(errorMessage.length);       

    });


    function ShowNotification(title, message, notifyType) {
        /*
        nodeType: error, info, warning, success
        */

       

        $.pnotify.defaults.styling = 'bootstrap3';
        $.pnotify({
            title: title,
            text: message,
            hide: true,
            type: notifyType,
            delay: 10000,
            stack: { 'dir1': 'down', 'dir2': 'middle', 'push': 'top' },
            history: false,
        });
    }

</script>

