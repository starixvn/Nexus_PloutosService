@model IEnumerable<blueberry.core.src.Models.PaymentGatewayBank>
@using blueberry.utils.src.DataTypeConvesion

@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>List</h2>

<p>
    
</p>


@using (Html.BeginForm("", "PaymentGatewayBank", FormMethod.Post, new { id = "activateDeactivateAction" }))
{
    <div class="form-horizontal">
        <div class="form-group">
            @Html.Label("Payment Gateway", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <select name="paymentGateway" class="form-control">
                    <option value="100">All</option>
                    <option value="0">Daddy Pay</option>
                    <option value="1">Safe Pay</option>
                </select>
            </div>
        </div>


        <div class="form-group">
            <div class="col-md-10">
                <button type="submit" value="Activate" id="Activate" name="action:Activate" class="btn btn-primary">
                    Activate
                </button>
                <button type="submit" value="Deactivate" id="Deactivate" name="action:Deactivate" class="btn btn-primary">
                    Deactivate
                </button>
                @Html.ActionLink("Create New", "Create", null, htmlAttributes: new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>    
}

<hr />


<table id="records" class="table table-striped table-bordered">
    <thead>

        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BankCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankAbb)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BankNameEn)
            </th>
            <th>
                Payment Gateway
            </th>
            <th>
                Brand
            </th>
            <th>
                Deposit Mode
            </th>
            <th>
                Active
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.BankCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BankAbb)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BankName)
                </td>
                <th>
                    @Html.DisplayFor(modelItem => item.BankNameEn)
                </th>
                <td>
                    @item.PaymentGateway.GetDisplayName()
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.BrandCode)
                </td>
                <td>
                    @item.DepositMode.GetDisplayName()
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ActiveRecord)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-warning btn-xs" }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-info btn-xs" }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-danger btn-xs" })
                </td>
            </tr>
        }
    </tbody>

</table>




<script type="text/javascript">
    $(document).ready(function () {

        //$('#records').DataTable();

        $('#records').dataTable({
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
            "pageLength": 50
        });

    });
</script>