@using blueberry.messagehub.Models
@model IList<blueberry.messagehub.Models.HubClientConnection>


@{
    ViewBag.Title = "Connected Players";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Connected Players</h2>


<h2>Users</h2>

<table id="records" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                User Name
            </th>
            <th>
                Connection Id
            </th>
            <th>
                SignalR Token Id
            </th>
            <th>
                Connection Time
            </th>
            <th>
                Action
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (HubClientConnection item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ConnectionId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SignalRTokenKey)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TimeConnected)
                </td>
                <td>
                    <a href="@Url.Action("KickPlayer", "PlayerTransaction", new { userName = item.UserName })"><i class="fa fa-power-off"></i> <span>Log Out</span></a>
                </td>
                
            </tr>
        }
    </tbody>

</table>

<script type="text/javascript">
    $(document).ready(function () {
        $('#records').DataTable({
            "bPaginate": true,
            "bLengthChange": true,
            "bFilter": true,
            "bSort": true,
            "bInfo": true,
            "bAutoWidth": true,
            "asStripClasses": null, //To remove "odd"/"event" zebra classes
            "bJQueryUI": true,
            "sPaginationType": "full_numbers",
        });
    });
</script>