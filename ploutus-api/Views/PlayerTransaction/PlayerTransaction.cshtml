
@model dynamic
@using blueberry.core.src.Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Player Transactions";
}



<h2>@ViewBag.Title.</h2>


<div class="container">
    <dl class="dl-horizontal">

        <dt>
            Account number:
        </dt>
        <dd>
            @Model.PlayerRegistration.UserAccountNo
        </dd>

        <dt>
            Account Id:
        </dt>
        <dd>
            @Model.PlayerRegistration.Id
        </dd>

        <dt>
            Rollbase Id:
        </dt>
        <dd>
            @Model.PlayerRegistration.RollbaseId
        </dd>

        <dt>
            User Name:
        </dt>
        <dd>
            @Model.PlayerRegistration.UserName
        </dd>
        <dt>
            Name:
        </dt>
        <dd>
            @if (Model.PlayerProfile != null)
        {
            @Model.PlayerProfile.FullName
        }
        </dd>

        @if (@Model.WalletComputedBalance != null)
        {
            <dt>
                Wallet Code:
            </dt>
            <dd>
                @Model.WalletComputedBalance.WalletCode
            </dd>
        <dt>
            Updated Balance:
        </dt>
        <dd>
            @Model.WalletComputedBalance.UpdatedBalance (as of @Model.Wallet.WalletLastUpdated)
        </dd>

        <dt>
            Balance:
        </dt>
        <dd>
            @Model.WalletComputedBalance.Balance (as of @Model.Wallet.WalletLastUpdated)
        </dd>

        <dt>
            Withdrawable Amount:
        </dt>
        <dd>
            @Model.WalletComputedBalance.WithdrawableAmount (as of @Model.Wallet.WalletLastUpdated)
        </dd>

        <dt>
            Wagering Requirement Amount:
        </dt>
        <dd>
            @Model.WalletComputedBalance.WageringRequirement
        </dd>

        <dt>
            Wagering Balance Amount:
        </dt>
        <dd>
            @Model.WalletComputedBalance.WageringBalance
        </dd>
    }
        <dt></dt>
        <dd>
            @Html.ActionLink("Process Wagering", "ProcessWagering", new { userName = Model.PlayerRegistration.UserName }, htmlAttributes: new { @class = "btn btn-primary" })            
            |
            @Html.ActionLink("Remove to OW Transfer Queue", "RemoveToOWTransferQueue", new { userName = Model.PlayerRegistration.UserName }, htmlAttributes: new { @class = "btn btn-primary" })
            |
            @Html.ActionLink("Remove to AG Transfer Queue", "RemoveToAGTransferQueue", new { userName = Model.PlayerRegistration.UserName }, htmlAttributes: new { @class = "btn btn-primary" })
            |
            @Html.ActionLink("Remove to PT Transfer Queue", "RemoveToPTTransferQueue", new { userName = Model.PlayerRegistration.UserName }, htmlAttributes: new { @class = "btn btn-primary" })
        </dd>


    </dl>
</div>
<div class="container">
    <hr />
    <ul class="nav nav-tabs">
        <li><a data-toggle="tab" href="#Deposits">Deposits</a></li>
        <li><a data-toggle="tab" href="#Adjustments">Adjustments</a></li>
        <li><a data-toggle="tab" href="#Withdrawals">Withdrawals</a></li>
        <li><a data-toggle="tab" href="#Wins">Wins</a></li>
        <li><a data-toggle="tab" href="#Loss">Loss</a></li>
        <li><a data-toggle="tab" href="#Bets">Bets</a></li>
        <li><a data-toggle="tab" href="#Wagering">Wagering </a></li>
    </ul>

    <div class="tab-content">
        <div id="Deposits" class="tab-pane fade in active">
            <p><b>Player Deposits</b></p>
            <div style="overflow-y: auto; width: 100%; overflow-x:scroll">

                <table id="depositRecords" class="table table-striped" style="overflow-y: scroll">
                    <thead>
                        <tr>
                            <th>
                                RB Id
                            </th>
                            <th>
                                Transaction No.
                            </th>
                            <th>
                                Ref Transaction No.
                            </th>
                            <th>
                                Ref Transaction Remarks
                            </th>
                            <th>
                                Actual Deposit Amount
                            </th>

                            <th>
                                Wagering Amount
                            </th>

                            <th>
                                Wagering Fulfillment Amount
                            </th>

                            <th>
                                Bonus Amount
                            </th>
                            <th>
                                Bonus Wagering Amount
                            </th>

                            <th>
                                Total Wagering Amount
                            </th>

                            <th>
                                Wagering Balance Amount
                            </th>

                            <th>
                                Wagering Fulfilled
                            </th>

                            <th>
                                Bonus Code
                            </th>
                            <th>
                                Status
                            </th>
                            <th>
                                Approved Date
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (WalletDeposit item in Model.WalletDeposits)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RollbaseId)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TransactionNo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RefTransactionNo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RefDepositRemarks)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ActualDepositAmount)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.WageringAmount)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.WageringFulfillmentAmount)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.BonusAmount)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.BonusWageringAmount)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.TotalWageringAmount)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.WageringBalanceAmount)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.IsWageringFulfilled)
                                </td>

                                <td>
                                    @if (item.Bonus != null)
                                    {
                                        @Html.DisplayFor(modelItem => item.Bonus.BonusCode)
                                    }
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.Status)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.ApprovedDate)
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <div id="Withdrawals" class="tab-pane fade">


            <p><b>Player Withdrawal</b></p>
            <table id="depositRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>
                            RB Id
                        </th>
                        <th>
                            Withdraw Amount
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Approved Date
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (WalletWithdrawal item in Model.WalletWithdrawals)
            {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.RollbaseId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.WithdrawAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>


        <div id="Adjustments" class="tab-pane fade">


            <p><b>Player Adjustments</b></p>
            <table id="depositRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>
                            RB Id
                        </th>
                        <th>
                            Type
                        </th>
                        <th>
                            Transaction No
                        </th>
                        <th>
                            Credit Amount
                        </th>
                        <th>
                            Debit Amount
                        </th>
                        <th>
                            Transaction Date
                        </th>
                        <th>
                            Status
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (WalletAdjustmentMemo item in Model.WalletAdjustmentMemos)
            {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.RollbaseId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AdjustmentType)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreditAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DebitAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>


        <div id="Wins" class="tab-pane fade">

            <p><b>Player Wins</b></p>
            <table id="walletWinRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>
                            RB Id
                        </th>
                        <th>
                            Transaction No
                        </th>

                        <th>
                            Transaction Date
                        </th>

                        <th>
                            Bet Amount
                        </th>

                        <th>
                            Win Amount
                        </th>
                        <th>
                            Game Platform Code
                        </th>

                        <th>
                            Is Being Pushed
                        </th>

                        <th>
                            Remarks
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (WalletWin item in Model.WalletWins)
            {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.RollbaseId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BetAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.WinAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.GamePlatform.GamePlatformCode)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.IsBeingPushed)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Remarks)
                            </td>


                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <div id="Loss" class="tab-pane fade">
            <p><b>Player Loss</b></p>
            <table id="walletLossRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>
                            RB Id
                        </th>
                        <th>
                            Transaction No
                        </th>

                        <th>
                            Transaction Date
                        </th>

                        <th>
                            Bet Amount
                        </th>

                        <th>
                            Loss Amount
                        </th>
                        <th>
                            Game Platform Code
                        </th>

                        <th>
                            Is Being Pushed
                        </th>

                        <th>
                            Remarks
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (WalletLoss item in Model.WalletLosses)
            {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.RollbaseId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BetAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.LossAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.GamePlatform.GamePlatformCode)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.IsBeingPushed)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Remarks)
                            </td>


                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <div id="Bets" class="tab-pane fade">
            <p><b>Player Bets</b></p>
            <table id="playerBetsRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>

                        <th>
                            RB Id
                        </th>

                        <th>
                            Transaction No
                        </th>

                        <th>
                            Transaction Date
                        </th>

                        <th>
                            Bet Amount
                        </th>
                        <th>
                            Game Platform Code
                        </th>

                        <th>
                            Is Being Pushed
                        </th>
                        <th>
                            Is Done Wagering
                        </th>

                        <th>
                            Is Wage Being Process
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PlayerBet item in Model.PlayerBets)
            {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.RollbaseId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransactionDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BetAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.GamePlatform.GamePlatformCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsBeingPushed)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsDoneWagering)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsWageBeingProcess)
                            </td>


                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <div id="Wagering" class="tab-pane fade">
            <p><b>Wagering fulfillment</b></p>
            <table id="wageringFulfillmentRecords" class="table table-striped table-bordered">
                <thead>
                    <tr>

                        <th>
                            RB Id
                        </th>

                        <th>
                            Transaction No
                        </th>

                        <th>
                            Bet Amount
                        </th>
                        <th>
                            Game Platform Code
                        </th>

                        <th>
                            Is Being Pushed
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (WageringFulfilment item in Model.WageringFulfillments)
            {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.WalletDeposit.RollbaseId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PlayerBet.TransactionNo)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.BetAmount)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.PlayerBet.GamePlatform.GamePlatformCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsBeingPushed)
                            </td>



                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('#depositRecords').DataTable();
        $('#walletWinRecords').DataTable();
        $('#walletLossRecords').DataTable();
        $('#playerBetsRecords').DataTable();
        $('#wageringFulfillmentRecords').DataTable();

    });
</script>
