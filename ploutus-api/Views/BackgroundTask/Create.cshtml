@model blueberry.core.src.Models.BackgroundTaskSchedule
@using blueberry.core.src.Const

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@{
    ViewBag.Title = "Create Background Task";
}

<h2></h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4></h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


        <div class="form-group">
            @Html.LabelFor(model => model.BackgroundTaskType, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EnumDropDownListFor(model => model.BackgroundTaskType, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.BackgroundTaskType, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.NotifyEmailAddress, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.NotifyEmailAddress, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.NotifyEmailAddress, "", new { @class = "text-danger" })
            </div>
        </div>

        @{
            var SelectedRepeatType = Model != null ? Model.RepeatType : 2;
            var timeOfDay = DateTime.Now.ToString("hh:mm:ss tt");
        }

        <div class="form-group">
            <label class="control-label col-md-2">Repeat every</label>
            <div class="col-md-10 radio">
                @foreach (var item in RepeatTypes.RepeatType())
                {
                    if (item.Key == SelectedRepeatType)
                    {
                        <label> @Html.RadioButtonFor(model => model.RepeatType, item.Key, htmlAttributes: new { @checked = "checked", @class = $"RepeatType{item.Key}" })@item.Value</label>
                    }
                    else
                    {
                        <label> @Html.RadioButtonFor(model => model.RepeatType, item.Key, htmlAttributes: new { @class = $"RepeatType{item.Key}" })@item.Value</label>
                    }
                    <br />
                }
            </div>
        </div>

        <div class="form-group per-minute">
            @Html.LabelFor(model => model.Minute, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">

                <select id="Minute" name="Minute" class="form-control" style="width:100px">
                    @for (int i = 1; i < 60; i++)
                    {
                        <option value="@i">
                            @i
                        </option>

                    }
                </select>
            </div>
        </div>

        <div class="form-group per-hour">
            @Html.LabelFor(model => model.Hour, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">

                <select id="Hour" name="Hour" class="form-control" style="width:100px">
                    @for (int i = 0; i < 24; i++)
                    {
                        <option value="@i">
                            @i
                        </option>

                    }
                </select>
            </div>
        </div>

        <div class="form-group per-day">
            @Html.LabelFor(model => model.TimeOfDay, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <input type="text" id="TimeOfDay" name="TimeOfDay" value="@timeOfDay" class="form-control" />
                @Html.ValidationMessageFor(model => model.TimeOfDay, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-success" />
                @Html.ActionLink("Back to List", "List", null, htmlAttributes: new { @class = "btn btn-info" })
            </div>
        </div>
    </div>
            }


<script type="text/javascript">
    $(document).ready(function () {
        showHideTimeInput();

        $(".RepeatType0").click(function () {
            showHideTimeInput();
        });
        $(".RepeatType1").click(function () {
            showHideTimeInput();
        });
        $(".RepeatType2").click(function () {
            showHideTimeInput();
        });

        $('#TimeOfDay').timepicker();
        $('#TimeOfDay').css("width", "120px")

    });

    function showHideTimeInput() {

        var RepeatType = $("#RepeatType:checked");

        if (RepeatType.val() == '0') {
            $('.per-minute').show();
            $('.per-hour').hide();
            $('.per-day').hide();
        }
        if (RepeatType.val() == '1') {
            $('.per-minute').hide();
            $('.per-hour').show();
            $('.per-day').hide();
        }
        if (RepeatType.val() == '2') {
            $('.per-minute').hide();
            $('.per-hour').hide();
            $('.per-day').show();
        }
    }


</script>


