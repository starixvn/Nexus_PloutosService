<?xml version="1.0" encoding="utf-8" ?>
<objects xmlns="http://www.springframework.net"
         xmlns:tx="http://www.springframework.net/tx" default-autowire="constructor">




  <object id="BGAbstractService" type="BoomingGames.Api.src.implementations.BGAbstractService, BoomingGames.Api" abstract="true">
    <property name="ConnectionTimeout" value="3600000"/>
  </object>

  <object id="BGGameService" type="BoomingGames.Api.src.implementations.BGGameService, BoomingGames.Api" parent="BGAbstractService">


    <property name="WalletService" ref="WalletService"/>
    <property name="BGPlayerSessionService" ref="BGPlayerSessionService"/>
    <property name="BGGameEventsService" ref="BGGameEventsService"/>
    <property name="WalletManager" ref="WalletManager"/>
    <property name="PlayerRegistrationService" ref="PlayerRegistrationService"/>
    <property name="WalletLedgerService" ref="WalletLedgerService"/>
    <!--<property name="Credentials" ref="Credentials"/>-->

  </object>


  <tx:attribute-driven/>

</objects>
