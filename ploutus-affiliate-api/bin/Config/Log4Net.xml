<?xml version="1.0" encoding="utf-8" ?>
<log4net debug="false">

   <appender name="ApplicationAuthenticationHandlerFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/APP_AUTH_HANDLER_LOG.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="1MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline" />
    </layout>
  </appender>
    
  <appender name="WalletServiceFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/WALLETSERVICE_LOG.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline" />
    </layout>
  </appender>

  <appender name="PandoraServiceFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/PSERVICE_LOG.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline" />
    </layout>
  </appender>

  <appender name="PandoraApiManagersFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/PAPIMANAGERS_LOG.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline" />
    </layout>
  </appender>

  <appender name="RollbaseFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/ROLLBASE_LOG.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline" />
    </layout>
  </appender>

  <appender name="SpringRollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/spring_log.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline" />
    </layout>
  </appender>


  <appender name="NHibernateFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/NHibernate_log.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline" />
    </layout>
  </appender>


  <appender name="NHibernateSQLFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/NHSQL_log.txt"/>
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%newline%newline%newline" />
    </layout>

  </appender>


  <appender name="AspNetTraceAppender" type="log4net.Appender.AspNetTraceAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="[%thread] %-5level - %message" />
    </layout>
  </appender>

  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/log.txt" />
    <preserveLogFileNameExtension value="true" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="50" />
    <maximumFileSize value="2MB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date - %message%newline%newline" />
    </layout>
  </appender>

  <appender name="TraceAppender" type="log4net.Appender.TraceAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%-5level %M - %message%newline%newline" />
    </layout>
  </appender>

  <appender name="MemoryAppender" type="log4net.Appender.MemoryAppender">
    <!-- simple appender to get results to UI -->
  </appender>

  <!--Set default logging level to DEBUG-->
  <root>
    <level value="ERROR" />
    <appender-ref ref="SpringRollingFileAppender" />
    <appender-ref ref="AspNetTraceAppender" />
    <appender-ref ref="TraceAppender" />
  </root>
  <!--
    In Spring.NET there is a 1-1 correspondence between the logger name and
    the namespace of the class doing the logging...
  -->

  <logger name="Spring" >
    <level value="ERROR" />
  </logger>

  <logger name="blueberry.affiliate.Api.Authentication.ApplicationAuthenticationHandler">
    <level value="ALL" />
    <appender-ref ref="ApplicationAuthenticationHandlerFileAppender" />
  </logger>
  
  <logger name="blueberry">
    <level value="ALL" />
    <appender-ref ref="RollingFileAppender" />
  </logger>

  <logger name="NHibernate">
    <level value="ERROR" />
    <appender-ref ref="NHibernateFileAppender" />
  </logger>

  <logger name="NHibernate.Loader.Loader">
    <level value="INFO" />
    <appender-ref ref="NHibernateSQLFileAppender" />
  </logger>

  <logger name="Rollbase.Service">
    <level value="ALL" />
    <appender-ref ref="RollbaseFileAppender" />
  </logger>

  <logger name="blueberry.service.src.Implementations">
    <level value="ALL" />
    <appender-ref ref="PandoraServiceFileAppender" />
  </logger>

  <logger name="blueberry.affiliate.api">
    <level value="ALL" />
    <appender-ref ref="PandoraApiManagersFileAppender" />
  </logger>

  <logger name="blueberry.service.src.Implementations.WalletService">
    <level value="ALL" />
    <appender-ref ref="WalletServiceFileAppender" />
  </logger>



</log4net>