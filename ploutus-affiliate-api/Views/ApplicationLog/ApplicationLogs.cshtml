@{
    ViewBag.Title = "Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Index</h2>


<h2>Log Files</h2>

<table id="records" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                Log File
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a href="~/Logs/@item.Value" title="@item.Key" target="_blank">@item.Key</a>
                </td>
                <td>
                    @Html.ActionLink("Archive", "ArchiveLog", new { fileName = @item.Value }, htmlAttributes: new { @class = "btn btn-primary" })
                </td>
            </tr>
        }
    </tbody>

</table>

<script type="text/javascript">
    $(document).ready(function () {
        $('#records').DataTable();
    });
</script>