@using Microsoft.AspNet.Identity
@using blueberry.common.src.Const

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")    
    @Scripts.Render("~/bundles/modernizr")

    
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("Affiliate Manager", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, null)</li>
                    @if (Request.IsAuthenticated && ViewContext.HttpContext.User.IsInRole("Administrator"))
                    {
                        <li>@Html.ActionLink("API", "Index", "Help", new { area = "" }, new { target = "_blank" })</li>
                    }
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </div>
    <div class="container body-content">

        <div class="row">
            <div class="col-lg-3">
                @if (Request.IsAuthenticated && ViewContext.HttpContext.User.IsInRole("Administrator"))
                {
                    <ul class="nav nav-pills nav-stacked" style="padding-top: 30px;">
                        <li>
                            @Html.ActionLink("LOGS", "Index", "ApplicationLog")
                        </li>
                    </ul>
                }
            </div>
            <div class="col-lg-9">
                @RenderBody()
            </div>
        </div>

        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Pandora</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/Scripts/jquery.dataTables.min.js")
    @Scripts.Render("~/Scripts/dataTables.bootstrap.min.js")
    @RenderSection("scripts", required: false)
    
</body>
</html>
