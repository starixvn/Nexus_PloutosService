@model IEnumerable<blueberry.core.src.Models.Affiliate>

@{
    ViewBag.Title = "Affiliates";
}

<h2>Affiliates</h2>

<table id="records" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AffiliateCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AffiliateName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RollbaseId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastLoginDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BonusCode)
            </th>
        </tr>
    </thead>
@foreach (var item in Model) {
    <tr>        
        <td>
            @Html.DisplayFor(modelItem => item.AffiliateCode)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AffiliateName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.RollbaseId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.UserName)
        </td>        
        <td>
            @Html.DisplayFor(modelItem => item.LastLoginDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.BonusCode)
        </td>        
    </tr>
}

</table>


<script type="text/javascript">
    $(document).ready(function () {
        $('#records').DataTable({
            "bPaginate": true,
            "bLengthChange": true,
            "bFilter": true,
            "bSort": true,
            "bInfo": true,
            "bAutoWidth": true,
            "asStripClasses": null, //To remove "odd"/"event" zebra classes
            "bJQueryUI": true,
            "sPaginationType": "full_numbers",
            dom: 'lfriptB',//fliptB
            buttons: ['print', 'excel', 'pdf'],
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
            "order": [[2, "desc"]]
        });
    });
</script>