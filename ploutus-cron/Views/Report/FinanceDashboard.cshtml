@using Pandora.Models
@using blueberry.core.src.Enums
@using blueberry.core.src.Models
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="alert alert-success" id="success-alert">
    <button type="button" class="close" data-dismiss="alert">x</button>
    <strong><label id="strongMessage"></label> </strong>
    <label id="notifyMessage"></label>
</div>

<div class="alert alert-danger" id="danger-alert">
    <button type="button" class="close" data-dismiss="alert">x</button>
    <strong><label id="dangerStrongMessage"></label> </strong>
    <label id="dangerNotifyMessage"></label>
</div>


<h2>Dashboard</h2>

@Scripts.Render("https://www.google.com/jsapi")
@Scripts.Render("https://www.gstatic.com/charts/loader.js")

@section Scripts {
    @Scripts.Render("~/Scripts/jquery.signalR-2.2.1.js")
}




<p>
    <button data-toggle="collapse" data-target="#filter" class="glyphicon glyphicon-search"></button>
    Filters
</p>
<div id="filter" class="collapse">

    <div class="form-horizontal">

        <div class="form-group">
            @Html.Label("Start Date", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.Editor("StartDate", new { htmlAttributes = new { @class = "form-control date" } })
                @Html.ValidationMessage("date", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("End Date", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.Editor("EndDate", new { htmlAttributes = new { @class = "form-control date" } })
                @Html.ValidationMessage("date", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Player Type", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("PlayerType", EnumHelper.GetSelectList(typeof(PlayerType)), "Select Player Type(Default = Real)", new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Status", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <select class="form-control" id="Status" name="Status">
                    <option value="">Select Status(Default = Approved)</option>
                    <option value="2">Approved</option>
                    <option value="0">Requested</option>
                    <option value="4">Declined</option>
                    <option value="8">Online Deposit Processing</option>
                    <option value="10">Online Deposit Cancel</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button value="Refresh" id="Refresh" class="btn btn-info">
                    <span class="glyphicon glyphicon-search"></span> Search
                </button>
            </div>
        </div>
    </div>
    <hr />
</div>



<p>
    <button data-toggle="collapse" data-target="#totals" class="glyphicon glyphicon-equalizer"></button>
    Totals
</p>
<div id="totals" class="collapse">
    <table class="table">
        <thead class="thead-inverse">
            <tr>
                <th>Total For</th>
                <th>Deposit</th>
                <th>Withdrawal</th>
                <th>Net</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">Today</th>
                <td><label class="control-label" id="totalDepositToday">0.00</label></td>
                <td><label class="control-label" id="totalWithdrawalToday">0.00</label></td>
                <td>
                    <span id="spanTotalDepLessWithToday">
                        <label class="control-label" id="totalDepLessWithToday" data-toggle="tooltip" data-placement="right">0.00</label>
                    </span>
                </td>
            </tr>
            <tr>
                <th scope="row">This Week</th>
                <td><label class="control-label" id="totalDepositThisWeek">0.00</label></td>
                <td><label class="control-label" id="totalWithdrawalThisWeek">0.00</label></td>
                <td>
                    <span id="spanTotalDepLessWithThisWeek">
                        <label class="control-label" id="totalDepLessWithThisWeek" data-toggle="tooltip" data-placement="right">0.00</label>
                    </span>
                </td>
            </tr>
            <tr>
                <th scope="row">This Month</th>
                <td><label class="control-label" id="totalDepositThisMonth">0.00</label></td>
                <td><label class="control-label" id="totalWithdrawalThisMonth">0.00</label></td>
                <td>
                    <span id="spanTotalDepLessWithThisMonth">
                        <label class="control-label" id="totalDepLessWithThisMonth" data-toggle="tooltip" data-placement="right">0.00</label>
                    </span>
                </td>
            </tr>

        </tbody>
    </table>
</div>

<p>
    <button data-toggle="collapse" data-target="#charts" class="glyphicon glyphicon-signal" id="chartsButton"></button>
    Charts
</p>
<div id="charts" class="collapse">

    <ul>
        <li>
            <div id="depositWithdrawals_div" style="border: 1px solid #ccc" />
        </li>
        <li>
            <div id="deposits_div" style="border: 1px solid #ccc" />
        </li>
        <li>
            <div id="withdrawal_div" style="border: 1px solid #ccc" />
        </li>
    </ul>
</div>

<style>
    .chart {
        width: 100%;
        min-height: 450px;
    }
</style>





<div class="loader">
    <p></p>
</div>

<script type="text/javascript">
    google.load("visualization", "1", {packages:["corechart"]});
    //google.setOnLoadCallback(drawChart);
    //google.charts.load('current', { 'packages': ['line'] });


    function drawChart(elemId, title, records) {

        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Date');
        data.addColumn('number', '');
        for (var i = 0; i < records.length; i++) {
            var row = new Array();
            row[0] = records[i].TxnDesc;
            row[1] = parseFloat(records[i].Amount);
            data.addRow(row);
        }

        var elem = document.getElementById(elemId);
        var chart = new google.visualization.LineChart(elem);

        var options = {
            legend: 'none',
            chart: {
                title: title,
                subtitle: '',
                legend: 'none',
                hAxis: { title: '', titleTextStyle: { color: 'red' } },
            },
            hAxis: { textPosition: 'none',
                title: title},
            axes: {
                x: {
                    0: { side: 'top' }
                }
            }
        };

        chart.draw(data, options);
    }

    function drawdepositWithdrawChart(elemId, title, records) {
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Date');
        data.addColumn('number', 'Deposit');
        data.addColumn('number', 'Withdraw');


        for (var i = 0; i < records.length; i++) {
            var row = new Array();
            row[0] = records[i].STxnDate;
            row[1] = parseFloat(records[i].Amount1);
            row[2] = parseFloat(records[i].Amount2);
            data.addRow(row);
        }

        var elem = document.getElementById(elemId);
        var chart = new google.visualization.LineChart(elem);
        //var chart = new google.charts.Line(elem);

        var options = {
            //legend: 'none',
            chart: {
                title: title,
                subtitle: '',
                legend: 'none',
                hAxis: { title: '', titleTextStyle: { color: 'red' } },
            },
            hAxis: {
                //textPosition: 'none',
                //title: title
            },
            axes: {
                x: {
                    0: { side: 'top' }
                }
            }
        };

        chart.draw(data, options);
    }

    function getRandomColor() {
        var letters = '0123456789ABCDEF'.split('');
        var color = '#';
        for (var i = 0; i < 6; i++) {
            color += letters[Math.floor(Math.random() * 16)];
        }
        return color;
    }



    var financeData =
        {TotalDepositToday:0,
            TotalDepositThisWeek:0,
            TotalDepositThisMonth:0,
            TotalWithdrawalToday:0,
            TotalWithdrawalThisWeek:0,
            TotalWithdrawalThisMonth:0,
        };

    var chartData = {
        Deposits:{},
        Withdrawals:{},
        DepositWithdrawals:{}
    };

    $(document).ready(function () {

        $('.loader').hide();

        $('.date').datepicker()
            .on('changeDate', function (e) {
                $(this).datepicker('hide');
            });


        $('#charts').collapse({
            toggle: true
        })



        $(".alert").hide();

        $('#totalDepositToday').text(addCommas(parseFloat("@ViewBag.TotalDepositToday").toFixed(2)));
        $('#totalDepositThisWeek').text(addCommas(parseFloat("@ViewBag.TotalDepositThisWeek").toFixed(2)));
        $('#totalDepositThisMonth').text(addCommas(parseFloat("@ViewBag.TotalDepositThisMonth").toFixed(2)));

        $('#totalWithdrawalToday').text(addCommas(parseFloat("@ViewBag.TotalWithdrawalToday").toFixed(2)));
        $('#totalWithdrawalThisWeek').text(addCommas(parseFloat("@ViewBag.TotalWithdrawalThisWeek").toFixed(2)));
        $('#totalWithdrawalThisMonth').text(addCommas(parseFloat("@ViewBag.TotalWithdrawalThisMonth").toFixed(2)));

        financeData.TotalDepositToday = @ViewBag.TotalDepositToday;
        financeData.TotalDepositThisWeek = @ViewBag.TotalDepositThisWeek;
        financeData.TotalDepositThisMonth = @ViewBag.TotalDepositThisMonth;

        financeData.TotalWithdrawalToday = @ViewBag.TotalWithdrawalToday;
        financeData.TotalWithdrawalThisWeek = @ViewBag.TotalWithdrawalThisWeek;
        financeData.TotalWithdrawalThisMonth = @ViewBag.TotalWithdrawalThisMonth;

        $('#totalDepLessWithToday').text(addCommas(parseFloat(financeData.TotalDepositToday - financeData.TotalWithdrawalToday).toFixed(2)));
        $('#totalDepLessWithThisWeek').text(addCommas(parseFloat(financeData.TotalDepositThisWeek - financeData.TotalWithdrawalThisWeek).toFixed(2)));
        $('#totalDepLessWithThisMonth').text(addCommas(parseFloat(financeData.TotalDepositThisMonth - financeData.TotalWithdrawalThisMonth).toFixed(2)));




        //console.log(financeData)


        var Deposits = @Html.Raw(Json.Encode(ViewBag.Deposits));
        var Withdrawals = @Html.Raw(Json.Encode(ViewBag.Withdrawals));
        var DepositWithdrawals = @Html.Raw(Json.Encode(ViewBag.DepositWithdrawals));

        drawChart('deposits_div', "Deposits", Deposits);
        drawChart('withdrawal_div', "Withdrawals", Withdrawals);
        drawdepositWithdrawChart('depositWithdrawals_div', "Deposit/Withdrawals", DepositWithdrawals);

        chartData.Deposits = Deposits;
        chartData.Withdrawals = Withdrawals;
        chartData.DepositWithdrawals = DepositWithdrawals;

        $('#Refresh').click(function () {
            $('.loader').show();
            RefreshDashboard();
        });

        var conn = $.hubConnection();
        var hub = conn.createHubProxy('dashboardhub');


        hub.on('updateCashFlowDashboard', function(data){
            console.log('client called by server')

            drawChart('deposits_div', "Deposits", data.Deposits);
            drawChart('withdrawal_div', "Withdrawals", data.Withdrawals);
            drawdepositWithdrawChart('depositWithdrawals_div', "Deposit/Withdrawals", data.DepositWithdrawal);

            $('#totalDepositToday').text(addCommas(parseFloat(data.TotalDepositToday).toFixed(2)));
            $('#totalDepositThisWeek').text(addCommas(parseFloat(data.TotalDepositThisWeek).toFixed(2)));
            $('#totalDepositThisMonth').text(addCommas(parseFloat(data.TotalDepositThisMonth).toFixed(2)));

            $('#totalWithdrawalToday').text(addCommas(parseFloat(data.TotalWithdrawalToday).toFixed(2)));
            $('#totalWithdrawalThisWeek').text(addCommas(parseFloat(data.TotalWithdrawalThisWeek).toFixed(2)));
            $('#totalWithdrawalThisMonth').text(addCommas(parseFloat(data.TotalWithdrawalThisMonth).toFixed(2)));

            $('#totalDepositThisMonth').removeClass( "glyphicon glyphicon-arrow-up");
            $('#totalWithdrawalThisMonth').removeClass( "glyphicon glyphicon-arrow-up");

            $('#spanTotalDepLessWithToday').removeClass( "has-error" )
            $('#spanTotalDepLessWithThisWeek').removeClass("has-error")
            $('#spanTotalDepLessWithThisMonth').removeClass("has-error")

            chartData.Deposits = data.Deposits;
            chartData.Withdrawals = data.Withdrawals;
            chartData.DepositWithdrawals = data.DepositWithdrawals;


            if(data.TotalWithdrawalThisMonth > financeData.TotalWithdrawalThisMonth){
                $('#totalWithdrawalThisMonth').addClass( "glyphicon glyphicon-arrow-up" );
                $('#dangerStrongMessage').text('Withdrawal');
                $('#dangerNotifyMessage').text('From ' + addCommas(financeData.TotalWithdrawalThisMonth) + ' to ' + addCommas(data.TotalWithdrawalThisMonth));

                $("#danger-alert").show();
                $("#danger-alert").delay(10000).slideUp(1500, function() {
                    $("#danger-alert").hide();
                });

            }

            if(data.TotalDepositThisMonth > financeData.TotalDepositThisMonth){
                $('#totalDepositThisMonth').addClass( "glyphicon glyphicon-arrow-up");

                $('#strongMessage').text('Deposit');
                $('#notifyMessage').text('From ' + addCommas(financeData.TotalWithdrawalThisMonth) + ' to ' + addCommas(data.TotalDepositThisMonth));

                $("#success-alert").show();
                $("#success-alert").delay(10000).slideUp(1500, function() {
                    $("#success-alert").hide();
                });
            }

            $('#totalDepositToday').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalDepositToday).toFixed(2)));
            $('#totalDepositThisWeek').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalDepositThisWeek).toFixed(2)));
            $('#totalDepositThisMonth').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalDepositThisMonth).toFixed(2)));

            $('#totalWithdrawalToday').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalWithdrawalToday).toFixed(2)));
            $('#totalWithdrawalThisWeek').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalWithdrawalThisWeek).toFixed(2)));
            $('#totalWithdrawalThisMonth').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalWithdrawalThisMonth).toFixed(2)));

            $('#totalDepositToday').tooltip();
            $('#totalDepositThisWeek').tooltip();
            $('#totalDepositThisMonth').tooltip();

            $('#totalWithdrawalToday').tooltip();
            $('#totalWithdrawalThisWeek').tooltip();
            $('#totalWithdrawalThisMonth').tooltip();

            var curNetToday = financeData.TotalDepositToday - financeData.TotalWithdrawalToday;
            var curNetThisWeek = financeData.TotalDepositThisWeek - financeData.TotalWithdrawalThisWeek;
            var curNetThisMonth = financeData.TotalDepositThisMonth - financeData.TotalWithdrawalThisMonth;

            var newNetToday = data.TotalDepositToday - data.TotalWithdrawalToday;
            var newNetThisWeek = data.TotalDepositThisWeek - data.TotalWithdrawalThisWeek;
            var newNetThisMonth = data.TotalDepositThisMonth - data.TotalWithdrawalThisMonth;


            $('#totalDepLessWithToday').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalDepositToday - financeData.TotalWithdrawalToday).toFixed(2)));
            $('#totalDepLessWithThisWeek').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalDepositThisWeek - financeData.TotalWithdrawalThisWeek).toFixed(2)));
            $('#totalDepLessWithThisMonth').attr('title', 'Previous: ' + addCommas(parseFloat(financeData.TotalDepositThisMonth - financeData.TotalWithdrawalThisMonth).toFixed(2)));

            $('#totalDepLessWithToday').tooltip();
            $('#totalDepLessWithThisWeek').tooltip();
            $('#totalDepLessWithThisMonth').tooltip();

            financeData.TotalDepositToday = data.TotalDepositToday;
            financeData.TotalDepositThisWeek = data.TotalDepositThisWeek;
            financeData.TotalDepositThisMonth = data.TotalDepositThisMonth;
            financeData.TotalWithdrawalToday = data.TotalWithdrawalToday;
            financeData.TotalWithdrawalThisWeek = data.TotalWithdrawalThisWeek;
            financeData.TotalWithdrawalThisMonth = data.TotalWithdrawalThisMonth;

            $('#totalDepLessWithToday').text(addCommas(parseFloat(financeData.TotalDepositToday - financeData.TotalWithdrawalToday).toFixed(2)));
            $('#totalDepLessWithThisWeek').text(addCommas(parseFloat(financeData.TotalDepositThisWeek - financeData.TotalWithdrawalThisWeek).toFixed(2)));
            $('#totalDepLessWithThisMonth').text(addCommas(parseFloat(financeData.TotalDepositThisMonth - financeData.TotalWithdrawalThisMonth).toFixed(2)));


            if(curNetToday < newNetToday){
                $('#spanTotalDepLessWithToday').addClass( "has-error" )
            }
            if(curNetThisWeek < newNetThisWeek){
                $('#spanTotalDepLessWithThisWeek').addClass("has-error")
            }
            if(curNetThisMonth < newNetThisMonth){
                $('#spanTotalDepLessWithThisMonth').addClass("has-error")
            }



        });

        conn.start({ transport: 'longPolling' }, function(){
        })
        .done(function(){ console.log(conn.id)  })
        .fail(function(){ console.log('failed to connect signalr') });


    });

    function addCommas(nStr) {
        nStr += '';
        x = nStr.split('.');
        x1 = x[0];
        x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1)) {
            x1 = x1.replace(rgx, '$1' + ',' + '$2');
        }
        return x1 + x2;
    }


    function RefreshDashboard(){

        $.post('/Report/FinanceData/', {
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val(),
            PlayerType: $('#PlayerType').val(),
            Status: $('#Status').val(),
        },
        function (data) {
            
            drawChart('deposits_div', "Deposits", data.Deposits);
            drawChart('withdrawal_div', "Withdrawals", data.Withdrawals);
            drawdepositWithdrawChart('depositWithdrawals_div', "Deposit/Withdrawals", data.DepositWithdrawal);

            $('#totalDepositToday').text(addCommas(parseFloat(data.TotalDepositToday).toFixed(2)));
            $('#totalDepositThisWeek').text(addCommas(parseFloat(data.TotalDepositThisWeek).toFixed(2)));
            $('#totalDepositThisMonth').text(addCommas(parseFloat(data.TotalDepositThisMonth).toFixed(2)));

            $('#totalWithdrawalToday').text(addCommas(parseFloat(data.TotalWithdrawalToday).toFixed(2)));
            $('#totalWithdrawalThisWeek').text(addCommas(parseFloat(data.TotalWithdrawalThisWeek).toFixed(2)));
            $('#totalWithdrawalThisMonth').text(addCommas(parseFloat(data.TotalWithdrawalThisMonth).toFixed(2)));

            $('#totalDepLessWithToday').text(addCommas(parseFloat(data.TotalDepositToday - data.TotalWithdrawalToday).toFixed(2)));
            $('#totalDepLessWithThisWeek').text(addCommas(parseFloat(data.TotalDepositThisWeek - data.TotalWithdrawalThisWeek).toFixed(2)));
            $('#totalDepLessWithThisMonth').text(addCommas(parseFloat(data.TotalDepositThisMonth - data.TotalWithdrawalThisMonth).toFixed(2)));

            $('.loader').hide();

        }, 'json');


    }




</script>
