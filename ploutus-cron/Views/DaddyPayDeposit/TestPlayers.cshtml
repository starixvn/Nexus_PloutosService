@model IList<blueberry.security.manager.src.Models.PandoraUser>
@using System.Collections.Generic
    @{
        ViewBag.Title = "TestPlayers";
    }

    <h2>Test Players</h2>




    <table id="records" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>
                    Account No
                </th>
                <th>
                    User Name
                </th>
                <th>
                    Action
                </th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>               
                        @Html.DisplayFor(modelItem => item.PlayerAccountNo)       
                        @*@item.PlayerAccountNo*@                        
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UserName)                                           
                    </td>
                    <td>
                        @Html.ActionLink("WeChat", "DepositWeChat", "DaddyPayDeposit", new { userName = item.UserName }, htmlAttributes: new { @class = "btn btn-info btn-xs", @target = "_blank" })
                    </td>
                </tr>
            }
        </tbody>

    </table>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#records').DataTable({
                "bPaginate": true,
                "bLengthChange": true,
                "bFilter": true,
                "bSort": true,
                "bInfo": true,
                "bAutoWidth": true,
                "asStripClasses": null, //To remove "odd"/"event" zebra classes
                "bJQueryUI": true,
                "sPaginationType": "full_numbers",
            });
        });
    </script>