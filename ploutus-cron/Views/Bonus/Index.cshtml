@model IEnumerable<blueberry.core.src.Models.Bonus>

@{
    ViewBag.Title = "Bonus";
}

<h2>Bonus</h2>


<table id="records" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BonusCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BonusName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BonusDesc)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.ValidStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValidEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActiveBonus)
            </th>            
            <th>
                @Html.DisplayNameFor(model => model.RollbaseId)
            </th>           
        </tr>
    </thead>

@foreach (var item in Model)
{
    
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BonusCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BonusName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BonusDesc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValidStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ValidEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActiveBonus)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.RollbaseId)
            </td>           
        </tr>
    
}

</table>



<script type="text/javascript">
    $(document).ready(function () {
        $('#records').DataTable({
            "bPaginate": true,
            "bLengthChange": true,
            "bFilter": true,
            "bSort": true,
            "bInfo": true,
            "bAutoWidth": true,
            "asStripClasses": null, //To remove "odd"/"event" zebra classes
            "bJQueryUI": true,
            "sPaginationType": "full_numbers",
            dom: 'lfriptB',//fliptB
            buttons: ['print', 'excel', 'pdf'],
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
            "order": [[2, "desc"]]
        });
    });
</script>