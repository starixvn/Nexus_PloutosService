
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Fetch Game Log Manualy</h2>

@using (Html.BeginForm("ProcessOwGameBetLog", "FetcGameBet", FormMethod.Post, new { id = "ProcessOwGameBetLog" }))
{
    <div class="form-horizontal">
        <div class="form-group">
            @Html.Label("Game Log Version", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.Editor("versionKey", new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessage("versionKey", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button value="ProcessOwGameBetLog" id="ProcessOwGameBetLog" class="btn btn-default">
                    Get OW Log
                </button>                
            </div>
        </div>
    </div>
}

<hr />

@using (Html.BeginForm("ProcessAGLog", "FetcGameBet", FormMethod.Post, new { id = "ProcessAGLog" }))
{
    <div class="form-horizontal">
        <div class="form-group">
            @Html.Label("Date", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.Editor("date", new { htmlAttributes = new { @class = "form-control date" } })
                @Html.ValidationMessage("date", "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button value="ProcessAGLog" id="ProcessAGLog" class="btn btn-default">
                    Process AG Bet
                </button>
            </div>
        </div>
    </div>
}

