@model IEnumerable<blueberry.core.src.Models.BackgroundTaskSchedule>
@using blueberry.common.src.Const

@{
    ViewBag.Title = "Background Task";
}
<h2>Background Task</h2>

<p>
    @if (!ViewContext.HttpContext.User.IsInRole(ApplicationRoles.CronUser))
    {
    @Html.ActionLink("Create New", "Create", null, htmlAttributes: new { @class = "btn btn-primary" })
    }
    @if (Model.Count() > 0)
    {
        @:|
        @Html.ActionLink("Pause All", "PauseAllTask", null, htmlAttributes: new { @class = "btn btn-danger" }) @:|
        @Html.ActionLink("Resume All", "ResumeAllTask", null, htmlAttributes: new { @class = "btn btn-success" }) @:|
        @Html.ActionLink("Refresh All Schedule", "RecreateJobs", null, htmlAttributes: new { @class = "btn btn-success" }) @:|
        @Html.ActionLink("Pause Pending Jobs", "PausePendingJobs", null, htmlAttributes: new { @class = "btn btn-success" })@:|        
    }
</p>






<table id="records" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BackgroundTaskTypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NotifyEmailAddress)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.PreviousExecution)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.NextExecution)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.TriggerState)
            </th>


            <th>
                Action
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.ActionLink(item.BackgroundTaskTypeName, "Details", new { id = item.Id })
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NotifyEmailAddress)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PreviousExecution)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.NextExecution)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.TriggerState)
                </td>

                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-info btn-xs" })
                    @*@Html.ActionLink("Delete", "Delete", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-danger btn-xs" })*@
                    @if (item.TriggerState != "Paused")
                    {
                        @Html.ActionLink("Pause", "PauseTask", new { jobName = item.TaskName }, htmlAttributes: new { @class = "btn btn-warning btn-xs" })
                    }

                    @if (item.TriggerState == "Paused")
                    {
                        @Html.ActionLink("Resume", "ResumeTask", new { jobName = item.TaskName }, htmlAttributes: new { @class = "btn btn-success btn-xs" })
                    }
                    @Html.ActionLink("Refresh", "RecreateTask", new { id = item.Id }, htmlAttributes: new { @class = "btn btn-danger btn-xs" })
                </td>
            </tr>
        }
    </tbody>

</table>

<script type="text/javascript">
    $(document).ready(function () {

        $('#records').DataTable({
            "pageLength": 30,
            "bPaginate": true,
            "bLengthChange": true,
            "bFilter": true,
            "bSort": true,
            "bInfo": true,
            "bAutoWidth": true,
            "asStripClasses": null, //To remove "odd"/"event" zebra classes
            "bJQueryUI": true,
            "sPaginationType": "full_numbers",
            "lengthMenu": [[10, 25, 30, 50, -1], [10, 25, 30, 50, "All"]]
        });

    });
</script>
