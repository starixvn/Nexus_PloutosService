@model IEnumerable<blueberry.core.src.Models.GamePlatformProduct>

@{
    ViewBag.Title = "GameTypes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>GameTypes</h2>


<table id="records" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                Sequence
            </th>
            <th>
                Game Platform Product Code
            </th>
            <th>
                Game Platform Product Name
            </th>
            <th>
                Game Type
            </th>
            <th>
                Game Platform
            </th>
            <th>
                Game Log Code
            </th>

            <th>
                Image
            </th>
            <th>
                Active
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.SequenceNo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GamePlatformProductCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GamePlatformProductName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GameType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GamePlatform.GamePlatformCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GameLogCode)
                </td>               
                <td align="center" style="text-align:center">
                    <img src="@item.ImageUrl" width="70%" />                    
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ActiveRecord)
                </td>
            </tr>
        }
    </tbody>
</table>


<script type="text/javascript">
    $(document).ready(function () {
        $('#records').DataTable({
            "bPaginate": true,
            "bLengthChange": true,
            "bFilter": true,
            "bSort": true,
            "bInfo": true,
            "bAutoWidth": true,
            "asStripClasses": null, //To remove "odd"/"event" zebra classes
            "bJQueryUI": true,
            "sPaginationType": "full_numbers",
        });
    });
</script>