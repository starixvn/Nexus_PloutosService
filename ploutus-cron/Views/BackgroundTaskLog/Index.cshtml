
@{
    ViewBag.Title = "Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Log Files</h2>

<table id="records" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                Log File
            </th>                        
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a href="@item.Value" title="@item.Key" target="_blank">@item.Key</a>
                </td>                
            </tr>
        }
    </tbody>

</table>

<script type="text/javascript">
    $('#records').DataTable({
        "bPaginate": true,
        "bLengthChange": true,
        "bFilter": true,
        "bSort": true,
        "bInfo": true,
        "bAutoWidth": true,
        "asStripClasses": null, //To remove "odd"/"event" zebra classes
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
    });
</script>